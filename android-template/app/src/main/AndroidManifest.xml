<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package-visibility declaration (API 30+) so PackageManager can tell
         us whether a Custom Tabs provider (Chrome etc.) is actually
         installed before we try to launch one - without this the query
         silently returns nothing on API 30+ and every external link would
         fall back to a plain browser Intent. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- NFC tap bridge (window.AndroidNfc). NFC is a normal-protection-level
         permission - Android never shows a runtime prompt for it, it's only
         active on devices that actually have the hardware either way. -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- Location & geofencing bridge (window.AndroidLocation). Deliberately
         NOT requesting ACCESS_BACKGROUND_LOCATION here: that needs its own
         Play Store Data Safety disclosure and a separate runtime prompt
         flow, which is a decision for whoever publishes this specific app,
         not something to bake into every generated app. As a result,
         geofence transitions are reliable while the app is foreground or
         recently backgrounded, but are not guaranteed once Android has
         fully killed the process - see GeofenceBroadcastReceiver.java. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Battery optimization exemption (Settings screen, manual opt-in only -
         see SettingsActivity's "Reliable notifications & sync" row). Never
         requested automatically on launch, since Play Store policy restricts
         this permission to apps whose core function needs it and reviewers
         are wary of it being requested unprompted. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:name="com.webapp2apk.generated.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.WebApp2Apk">

        <activity
            android:name="com.webapp2apk.generated.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.WebApp2Apk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.webapp2apk.generated.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.WebApp2Apk">

            <!-- App Links: a link to the web app's own domain (e.g. shared
                 from WhatsApp/SMS/email, or tapped from a search result)
                 opens straight into this app instead of a browser tab.
                 autoVerify triggers Android's Digital Asset Links check
                 against https://{{APP_HOST}}/.well-known/assetlinks.json;
                 if that file isn't published, Android just silently keeps
                 treating these as ordinary (non-verified) links - it never
                 breaks the build or the app either way. onNewIntent in
                 MainActivity is what actually loads the URL once this
                 fires. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="{{APP_HOST}}" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.webapp2apk.generated.LockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.WebApp2Apk" />

        <activity
            android:name="com.webapp2apk.generated.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.WebApp2Apk" />

        <service
            android:name="com.webapp2apk.generated.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.webapp2apk.generated.WebAppWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/webapp_widget_info" />
        </receiver>

        <!-- Fires a system Notification when a scheduled local reminder
             (window.AndroidNotify.schedule) comes due. -->
        <receiver
            android:name="com.webapp2apk.generated.LocalNotificationReceiver"
            android:exported="false" />

        <!-- Fires when a registered geofence (window.AndroidLocation.
             startGeofence) is entered/exited. -->
        <receiver
            android:name="com.webapp2apk.generated.GeofenceBroadcastReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
