<?xml version="1.0" encoding="utf-8"?>
<!-- Solid white pill instead of a translucent black overlay - the previous
     version blended into whatever color the banner behind it happened to be
     (especially red/dark accent colors), making the retry button effectively
     invisible even though it was fully functional. White guarantees contrast
     against any banner color the app is configured with. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33000000">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#33000000" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</ripple>
