<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Slim top app bar: the only chrome. Everything else (reload, forward,
         settings) lives in the three-dot menu; back = the phone's back button. -->
    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@color/primary_dark_color"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="0dp">

        <TextView
            android:id="@+id/topBarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/banner_bg_offline"
        android:text="No internet connection \u00b7 tap to retry"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="10dp"
        android:elevation="4dp"
        android:alpha="0.95"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/updateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/banner_bg_update"
        android:text="A new version is available - tap to update"
        android:textColor="#04150A"
        android:textStyle="bold"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="10dp"
        android:elevation="4dp"
        android:alpha="0.95"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/syncPendingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/banner_bg_update"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:elevation="4dp"
        android:alpha="0.95"
        android:visibility="gone">

        <TextView
            android:id="@+id/syncPendingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#04150A"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/syncPendingSendNowButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Retry now"
            android:textColor="#04150A"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/sync_action_button_bg"
            android:elevation="2dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
            android:scrollbarThumbHorizontal="@drawable/scrollbar_thumb" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_color"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/progressBarIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottomTabBarContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="4dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="#33FFFFFF"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/tabIndicator"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_gravity="top|start"
            android:background="@color/accent_color"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/tabNotch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:background="@drawable/tab_notch_bg"
            android:alpha="0"
            android:translationY="4dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/bottomTabBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

    </FrameLayout>

</LinearLayout>

    <ImageButton
        android:id="@+id/moreButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="2dp"
        android:alpha="0.55"
        android:background="@drawable/float_menu_bg"
        android:contentDescription="More options"
        android:elevation="10dp"
        android:padding="5dp"
        android:src="@drawable/ic_more_vert"
        android:tint="#FFFFFF" />

</FrameLayout>
